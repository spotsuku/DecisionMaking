# AI(サーバー側だけ。ブラウザには出さないので NEXT_PUBLIC_ を付けない)
# OPENAI_API_KEY があれば OpenAI、無くて ANTHROPIC_API_KEY があれば Anthropic を使う。
# どちらも無い場合、AI補助は動かないがアプリはルールベースで全機能が動く。
OPENAI_API_KEY=
# 省略時: 会話 gpt-4.1 / 抽出・振り分け gpt-4.1-mini
OPENAI_MODEL_CHAT=
OPENAI_MODEL_CHEAP=
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STANDARD=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
